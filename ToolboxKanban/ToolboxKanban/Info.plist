<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Partielle Info.plist (#263). Übrige Keys werden von Xcode generiert
  (GENERATE_INFOPLIST_FILE=YES) und in diese Datei gemerged.

  ATS bleibt global aktiv (kein NSAllowsArbitraryLoads). Die einzige Ausnahme ist
  localhost für den Dev-Keycloak (http://localhost:8081); Release-Builds nutzen
  ohnehin die HTTPS-Prod-Config (OIDCConfig.current).
-->
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
