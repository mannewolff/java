DB_NAME=api
DB_USER=api
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Keycloak (Identity Provider, siehe infra/keycloak/README.md)
#
# KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD greifen NUR beim allerersten Start des
# Containers, wenn das Keycloak-Schema in der MariaDB noch leer ist. Sie legen den
# initialen Admin im master-Realm an. Bei allen weiteren Starts ignoriert Keycloak
# diese Variablen — das echte Admin-Passwort liegt dann in der Keycloak-DB und wird
# ueber das Keycloak-Admin-UI rotiert.
#
# Empfehlung fuer Produktion: nach dem ersten Setup das Klartext-Passwort hier durch
# einen sprechenden Platzhalter ersetzen (z.B. 'set-on-first-init-only'), damit klar
# ist, dass der Wert nur fuer Schema-Reset / Disaster-Recovery relevant ist.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Passwort fuer den dedizierten Keycloak-DB-User (Schema 'keycloak' in der gemeinsamen MariaDB).
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# App-Version (#229): Shared-Secret fuer die mutierenden increment-Endpunkte. Muss in der
# api-Umgebung UND fuer das Deploy-Skript (#225, scripts/increment-version.sh) identisch
# gesetzt sein. Leer lassen sperrt den Schreibzugriff komplett (deny-by-default).
APP_VERSION_INCREMENT_SECRET=change-me-version-token

# Internal-Auth (#265): Shared-Secret zwischen api (Spring) und python-tools. Beide Services
# lesen denselben Wert. Leer lassen sperrt die python-tools-Endpoints komplett (deny-by-default);
# fuer einen funktionierenden Stack muss hier ein nicht-leerer Wert stehen.
INTERNAL_API_KEY=change-me-internal-key
