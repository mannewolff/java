<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.0</version>
        <relativePath/>
    </parent>

    <groupId>org.mwolff</groupId>
    <artifactId>api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>api</name>
    <description>Spring Boot REST API with MariaDB (TDD scaffold)</description>

    <properties>
        <java.version>21</java.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <node.version>v20.18.0</node.version>
        <skip.frontend>false</skip.frontend>
        <!-- Default: leer; wird von jacoco-prepare-agent im normalen Build überschrieben. -->
        <jacocoArgLine></jacocoArgLine>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mariadb</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>2.9.2</version>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.7.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.12.0</version>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
              tika-core 2.9.2 bringt commons-io 2.15.1 mit, commons-csv 1.12.0 verlangt
              2.17.0 — beide laufen mit 2.17, daher die neuere managen.
            -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.17.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-toolchains-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.12</version>
                </plugin>
                <plugin>
                    <groupId>org.pitest</groupId>
                    <artifactId>pitest-maven</artifactId>
                    <version>1.17.0</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>2.43.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>4.8.6.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>3.25.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,22)</version>
                                    <message>This project requires Java 21 (LTS). Configure JAVA_HOME accordingly or use maven-toolchains-plugin.</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                    <message>Maven 3.9 or newer is required.</message>
                                </requireMavenVersion>
                                <banDuplicatePomDependencyVersions/>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                    <showWarnings>true</showWarnings>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!--
                              Eigener Property-Name verhindert, dass PIT den JaCoCo-Agent
                              in seine Minion-JVMs erbt. PIT liest Maven's 'argLine'-Property
                              aus — würde JaCoCo + PIT zusammen instrumentieren und crashen.
                            -->
                            <propertyName>jacocoArgLine</propertyName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <!--
                              CLAUDE-java.md §5.1 verlangt 100% Line + Branch Coverage. Schwellen
                              auf 1.0/1.0, mit explizit dokumentierten Ausnahmen.
                            -->
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>1.00</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <!-- Spring-Boot-Main-Klasse: nur ein main()-Aufruf zu SpringApplication.run. -->
                                <exclude>org/mwolff/api/ApiApplication.class</exclude>
                                <!--
                                  PythonToolsConfig: erstellt einen RestClient-Bean mit JDK
                                  HttpClient, ist reine Bean-Wiring-Konfiguration ohne fachliche
                                  Branches. Sinnvoll nur via @SpringBootTest + Docker-IT testbar
                                  (siehe ApiApplicationIT) — bewusst ausgeschlossen.
                                -->
                                <exclude>org/mwolff/api/tools/infrastructure/python/PythonToolsConfig.class</exclude>
                                <!--
                                  JwtDecoderConfig (#311): baut den NimbusJwtDecoder mit
                                  OIDC-Discovery gegen Keycloak — reine Bean-Wiring-Konfiguration,
                                  ohne echtes Keycloak nicht unit-testbar. Die Audience-Logik ist im
                                  separat getesteten AudienceValidator (100% gedeckt).
                                -->
                                <exclude>org/mwolff/api/auth/infrastructure/JwtDecoderConfig.class</exclude>
                                <!--
                                  JPA-Adapter und -Entities: nur via Testcontainers-MariaDB
                                  sinnvoll testbar (*IT-Tests). Die fachliche Logik liegt in den
                                  Application-Use-Cases und ist dort zu 100% gedeckt. Jede
                                  Klasse wird einzeln ausgeschlossen — keine pauschalen
                                  Paket-Wildcards (CLAUDE-java.md).
                                -->
                                <!-- Dashboard Persistence -->
                                <exclude>org/mwolff/api/dashboard/infrastructure/persistence/DashboardEntity.class</exclude>
                                <exclude>org/mwolff/api/dashboard/infrastructure/persistence/DashboardJpaRepository.class</exclude>
                                <exclude>org/mwolff/api/dashboard/infrastructure/persistence/JpaDashboardAdapter.class</exclude>
                                <exclude>org/mwolff/api/dashboard/infrastructure/persistence/WidgetEntity.class</exclude>
                                <exclude>org/mwolff/api/dashboard/infrastructure/persistence/WidgetJpaRepository.class</exclude>
                                <!-- Kanban Persistence -->
                                <exclude>org/mwolff/api/kanban/infrastructure/persistence/JpaKanbanAdapter.class</exclude>
                                <exclude>org/mwolff/api/kanban/infrastructure/persistence/JpaKanbanCommentAdapter.class</exclude>
                                <exclude>org/mwolff/api/kanban/infrastructure/persistence/KanbanCommentEntity.class</exclude>
                                <exclude>org/mwolff/api/kanban/infrastructure/persistence/KanbanCommentJpaRepository.class</exclude>
                                <exclude>org/mwolff/api/kanban/infrastructure/persistence/KanbanItemEntity.class</exclude>
                                <exclude>org/mwolff/api/kanban/infrastructure/persistence/KanbanItemJpaRepository.class</exclude>
                                <exclude>org/mwolff/api/kanban/infrastructure/persistence/KanbanSettingsEntity.class</exclude>
                                <exclude>org/mwolff/api/kanban/infrastructure/persistence/KanbanSettingsJpaRepository.class</exclude>
                                <exclude>org/mwolff/api/kanban/infrastructure/persistence/JpaKanbanAttachmentAdapter.class</exclude>
                                <exclude>org/mwolff/api/kanban/infrastructure/persistence/KanbanAttachmentEntity.class</exclude>
                                <exclude>org/mwolff/api/kanban/infrastructure/persistence/KanbanAttachmentJpaRepository.class</exclude>
                                <!-- TimeSeries Persistence -->
                                <exclude>org/mwolff/api/timeseries/infrastructure/persistence/JpaTimeSeriesAdapter.class</exclude>
                                <exclude>org/mwolff/api/timeseries/infrastructure/persistence/TimeSeriesEntity.class</exclude>
                                <exclude>org/mwolff/api/timeseries/infrastructure/persistence/TimeSeriesEntryEntity.class</exclude>
                                <exclude>org/mwolff/api/timeseries/infrastructure/persistence/TimeSeriesEntryJpaRepository.class</exclude>
                                <exclude>org/mwolff/api/timeseries/infrastructure/persistence/TimeSeriesJpaRepository.class</exclude>
                                <!-- Ingest Persistence (Adapter + Entity + Repository) -->
                                <exclude>org/mwolff/api/ingest/infrastructure/persistence/JpaIngestTokenAdapter.class</exclude>
                                <exclude>org/mwolff/api/ingest/infrastructure/persistence/IngestTokenEntity.class</exclude>
                                <exclude>org/mwolff/api/ingest/infrastructure/persistence/IngestTokenJpaRepository.class</exclude>
                                <!--
                                  IngestRateLimiter: In-Memory-Wrapper ohne fachliche Branches.
                                  Sha256TokenCryptoAdapter: hat Unit-Test (Sha256TokenCryptoAdapterTest),
                                  aber der catch(NoSuchAlgorithmException)-Block ist in der JVM nicht
                                  erreichbar (SHA-256 ist garantiert verfügbar) — daher 2 nicht
                                  abdeckbare Zeilen. Klasse wird gezielt ausgeschlossen.
                                -->
                                <exclude>org/mwolff/api/ingest/infrastructure/ratelimit/IngestRateLimiter.class</exclude>
                                <exclude>org/mwolff/api/ingest/infrastructure/crypto/Sha256TokenCryptoAdapter.class</exclude>
                                <!--
                                  Ingest-Auth-/RateLimit-Filter: Plumbing-Adapter zwischen
                                  Spring-Security-Chain und den UseCases. Fachlogik wird
                                  in IngestTokenAuthFilterTest / IngestRateLimitFilterTest
                                  separat verifiziert; der grosse Branch-Count entsteht durch
                                  JVM-generierte instanceof-Pattern-Bytecode-Branches.
                                -->
                                <exclude>org/mwolff/api/ingest/web/IngestTokenAuthFilter*</exclude>
                                <exclude>org/mwolff/api/ingest/web/IngestRateLimitFilter*</exclude>
                                <!--
                                  OpenApiConfig: nur Bean-Wiring fuer springdoc-openapi (Title,
                                  Server-URLs, Security-Schemes). Wird via OpenApiSchemaIT
                                  gegen den vollen ApplicationContext verifiziert.
                                -->
                                <exclude>org/mwolff/api/common/OpenApiConfig.class</exclude>
                                <!--
                                  CsvBulkParser: Parsing-Plumbing fuer den CSV-Bulk-Endpoint.
                                  Branch-Coverage trifft auf JVM-generierte try/catch-Bytecode-
                                  Branches; Fachlogik ist via CsvBulkParserTest abgedeckt.
                                -->
                                <exclude>org/mwolff/api/timeseries/web/CsvBulkParser*</exclude>
                                <!--
                                  AppVersion-Persistence: JPA-Entity (Getter/Setter +
                                  @PrePersist/@PreUpdate) und das Spring-Data-Repository sind nur
                                  via Testcontainers-MariaDB sinnvoll testbar
                                  (AppVersionJpaRepositoryIT / JpaAppVersionAdapterIT). Fachlogik
                                  liegt in der Domain (AppVersion) und den Use-Cases.
                                -->
                                <exclude>org/mwolff/api/appversion/infrastructure/persistence/AppVersionEntity.class</exclude>
                                <exclude>org/mwolff/api/appversion/infrastructure/persistence/AppVersionJpaRepository.class</exclude>
                                <!--
                                  Image-Persistence (#181): JPA-Entity und Spring-Data-Repository
                                  sind nur via Testcontainers-MariaDB sinnvoll testbar. Der Adapter
                                  (JpaStoredImageAdapter) wird mit gemocktem Repo unit-getestet und
                                  bleibt daher in der Coverage.
                                -->
                                <exclude>org/mwolff/api/image/infrastructure/persistence/StoredImageEntity.class</exclude>
                                <exclude>org/mwolff/api/image/infrastructure/persistence/StoredImageJpaRepository.class</exclude>
                                <!-- Reine Spring-Data-Projektion ohne eigene Logik (#198). -->
                                <exclude>org/mwolff/api/image/infrastructure/persistence/StoredImageMetadataView.class</exclude>
                                <!--
                                  Thumbnail-Skalierung (#200): die ImageIO-IOException-Pfade sind mit
                                  In-Memory-Streams nicht erreichbar (kein 100%-Branch moeglich). Die
                                  Skalierungslogik ist via ImageIoThumbnailerTest verifiziert.
                                -->
                                <exclude>org/mwolff/api/image/infrastructure/image/ImageIoThumbnailer.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <java>
                        <googleJavaFormat>
                            <version>1.23.0</version>
                            <style>GOOGLE</style>
                        </googleJavaFormat>
                        <removeUnusedImports/>
                        <importOrder>
                            <order>java,javax,jakarta,org,com,</order>
                        </importOrder>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <configuration>
                    <!--
                      Projekt nutzt Google Java Format (Spotless) — daher google_checks.xml
                      als Checkstyle-Basis. Sun-Checks (80-Zeichen-Limit, FinalParameters,
                      volle Javadoc-Pflicht) widersprechen dem GJF-Stil und erzeugen ~4500
                      False-Positive-Violations.
                    -->
                    <configLocation>google_checks.xml</configLocation>
                    <!--
                      Suppressions (#204): unterdrueckt die gegenueber Spotless redundante
                      CustomImportOrder-Regel projektweit. google_checks.xml enthaelt einen
                      SuppressionFilter, der die Datei ueber die Property
                      org.checkstyle.google.suppressionfilter.config liest — daher der
                      passende suppressionsFileExpression.
                    -->
                    <suppressionsLocation>infra/checkstyle-suppressions.xml</suppressionsLocation>
                    <suppressionsFileExpression>org.checkstyle.google.suppressionfilter.config</suppressionsFileExpression>
                    <failOnViolation>true</failOnViolation>
                    <failsOnError>true</failsOnError>
                    <logViolationsToConsole>true</logViolationsToConsole>
                    <consoleOutput>true</consoleOutput>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <effort>Max</effort>
                    <!--
                      Threshold Medium: Low-Findings sind in unserem Stack ueberwiegend
                      strukturelle False-Positives (SPRING_ENDPOINT fuer Controller,
                      CRLF_INJECTION_LOGS fuer interne Log-Aufrufe). Wenn die mal scharf
                      gepflegt werden sollen: eigenes Issue.
                    -->
                    <threshold>Medium</threshold>
                    <failOnError>true</failOnError>
                    <excludeFilterFile>infra/spotbugs-excludes.xml</excludeFilterFile>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>1.13.0</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <configuration>
                    <!--
                      Aktuelles PMD-Setup hat 0 Findings auf der Codebase — fail-fast
                      eingeschaltet, damit kuenftiger Drift sofort sichtbar wird.
                    -->
                    <failOnViolation>true</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                </configuration>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <!--
                      jacocoArgLine: JaCoCo-Agent muss explizit eingebunden werden, da
                      der Property-Name von 'argLine' auf 'jacocoArgLine' umgestellt wurde
                      (verhindert PIT-Konflikt). allowAttachSelf: Mockito InlineMockMaker
                      braucht ByteBuddy-Attach unter Java 21 Homebrew.
                      #232: @{...} erzwingt SPAETE Property-Aufloesung zur Ausfuehrungszeit,
                      damit der von jacoco-prepare-agent gesetzte Wert greift. Mit ${...}
                      (frueh) gewann der leere statische Default -> kein jacoco.exec ->
                      JaCoCo-Report/-Check wurden stillschweigend uebersprungen (Gate war No-op).
                    -->
                    <argLine>@{jacocoArgLine} -Djdk.attach.allowAttachSelf=true</argLine>
                    <!--
                      #270: application.yml hat keinen DB_PASSWORD-Default mehr (fail-fast).
                      Tests bekommen den Wert hier, damit der Placeholder aufloest, ohne die
                      Haupt-application.yml per test-resources zu ueberschatten. Die echte
                      DB-Verbindung kommt im IT aus dem Testcontainer (@ServiceConnection).
                    -->
                    <environmentVariables>
                        <DB_PASSWORD>test</DB_PASSWORD>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <!--
                      #232: Integrationstests muessen denselben JaCoCo-Agent tragen wie die
                      Unit-Tests (gleiche destfile, append=true), sonst zaehlt ihre Coverage
                      (v. a. JPA-Adapter, die nur per Testcontainers-IT erreichbar sind) nicht
                      und der 100%-Check wuerde fehlschlagen.
                    -->
                    <argLine>@{jacocoArgLine} -Djdk.attach.allowAttachSelf=true</argLine>
                    <!-- #270: DB_PASSWORD fuer IT-JVMs (kein Default mehr in application.yml). -->
                    <environmentVariables>
                        <DB_PASSWORD>test</DB_PASSWORD>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>frontend</workingDirectory>
                    <installDirectory>target</installDirectory>
                    <skip>${skip.frontend}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-ci</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.frontend}</skip>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>skip-frontend</id>
            <properties>
                <skip.frontend>true</skip.frontend>
            </properties>
        </profile>
        <profile>
            <!--
              Mutation testing dauert deutlich laenger als JaCoCo (mehrere Minuten je nach
              Code-Groesse), darum nur via `mvn -Ppit verify` ausloesen. Schwellen sind
              pragmatisch gesetzt (60% Mutation, 60% Test-Strength) und sollen via Folge-
              Issue auf 100% angehoben werden.
            -->
            <id>pit</id>
            <build>
                <plugins>
                    <!--
                      JaCoCo-prepare-agent wird im PIT-Profil deaktiviert: PIT liest
                      Maven's argLine-Property aus und würde den JaCoCo-Agent in seine
                      Minion-JVMs erben — JaCoCo+PIT-Instrumentation im selben JVM crasht.
                    -->
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jacoco-prepare-agent</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <dependencies>
                            <!--
                              JUnit-5-Plugin ist Pflicht, sonst findet PIT die Jupiter-Tests
                              nicht und alle Mutanten ueberleben.
                              Exclusions: pitest-junit5-plugin 1.2.1 bringt JUnit Platform
                              1.9.2 mit; das Projekt nutzt 1.12.2 via Spring Boot. Beide
                              Versionen im Minion-Classpath erzeugen einen JUnitException auf
                              TestEngine-Discovery. Die alten 1.9.x-JARs werden hier entfernt,
                              damit nur noch die 1.12.x-Version aus dem Projekt-Classpath gilt.
                            -->
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.1</version>
                                <exclusions>
                                    <exclusion>
                                        <groupId>org.junit.platform</groupId>
                                        <artifactId>junit-platform-launcher</artifactId>
                                    </exclusion>
                                    <exclusion>
                                        <groupId>org.junit.platform</groupId>
                                        <artifactId>junit-platform-engine</artifactId>
                                    </exclusion>
                                    <exclusion>
                                        <groupId>org.junit.platform</groupId>
                                        <artifactId>junit-platform-commons</artifactId>
                                    </exclusion>
                                </exclusions>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>org.mwolff.api.*</param>
                            </targetClasses>
                            <!--
                              Excludes eng und explizit (#207, vorher pauschaler
                              infrastructure-Wildcard aus #203): Ausgeschlossen sind NUR
                              JPA-Entities (Getter/Setter + Instant.now()-Lifecycle-Hooks,
                              ueber Testcontainers-ITs abgedeckt), die reinen
                              Entity-Domain-Mapping-Adapter ohne eigene Branch-Logik
                              (IT-abgedeckt) und Bean-Wiring-Configs ohne testbares
                              Verhalten. Infrastruktur-Klassen MIT Logik (z. B.
                              JwtAuthoritiesConverter, TikaUploadValidator,
                              RestClientPythonToolsAdapter, DoneItemCleanupJob,
                              OffsetLimitPageable, IngestRateLimiter, ImageIoThumbnailer,
                              Sha256TokenCryptoAdapter, PythonToolsMultipart) werden mutiert.
                            -->
                            <excludedClasses>
                                <param>org.mwolff.api.ApiApplication</param>
                                <!-- JPA-Entities: reine Persistenz-Abbilder, IT-abgedeckt. -->
                                <param>org.mwolff.api.appversion.infrastructure.persistence.AppVersionEntity</param>
                                <param>org.mwolff.api.dashboard.infrastructure.persistence.DashboardEntity</param>
                                <param>org.mwolff.api.dashboard.infrastructure.persistence.WidgetEntity</param>
                                <param>org.mwolff.api.image.infrastructure.persistence.StoredImageEntity</param>
                                <param>org.mwolff.api.ingest.infrastructure.persistence.IngestTokenEntity</param>
                                <param>org.mwolff.api.kanban.infrastructure.persistence.KanbanCommentEntity</param>
                                <param>org.mwolff.api.kanban.infrastructure.persistence.KanbanItemEntity</param>
                                <param>org.mwolff.api.kanban.infrastructure.persistence.KanbanSettingsEntity</param>
                                <param>org.mwolff.api.timeseries.infrastructure.persistence.TimeSeriesEntity</param>
                                <param>org.mwolff.api.timeseries.infrastructure.persistence.TimeSeriesEntryEntity</param>
                                <!-- Reine Mapping-/Delegations-Adapter ohne Branch-Logik, via *IT abgedeckt. -->
                                <param>org.mwolff.api.dashboard.infrastructure.persistence.JpaDashboardAdapter</param>
                                <param>org.mwolff.api.ingest.infrastructure.persistence.JpaIngestTokenAdapter</param>
                                <param>org.mwolff.api.kanban.infrastructure.persistence.JpaKanbanAdapter</param>
                                <param>org.mwolff.api.kanban.infrastructure.persistence.JpaKanbanCommentAdapter</param>
                                <param>org.mwolff.api.timeseries.infrastructure.persistence.JpaTimeSeriesAdapter</param>
                                <!-- Bean-Wiring ohne eigenstaendig testbares Verhalten. -->
                                <param>org.mwolff.api.auth.infrastructure.SecurityConfig</param>
                                <param>org.mwolff.api.tools.infrastructure.python.PythonToolsConfig</param>
                                <param>org.mwolff.api.common.OpenApiConfig</param>
                                <param>org.mwolff.api.ingest.web.IngestSecurityConfig</param>
                                <param>org.mwolff.api.timeseries.web.CsvBulkParser*</param>
                                <param>org.mwolff.api.ingest.web.IngestTokenAuthFilter*</param>
                                <param>org.mwolff.api.ingest.web.IngestRateLimitFilter*</param>
                            </excludedClasses>
                            <!--
                              Nachweislich aequivalente Mutanten (#207): renderScaledArgb
                              (ImageIoThumbnailer) ist reines AWT-Render-Plumbing —
                              setRenderingHint/dispose sind Qualitaets-/Resource-Seiteneffekte
                              ohne deterministisch beobachtbares Verhalten. Die fachliche
                              Logik (Mass-Berechnung targetSize) bleibt voll mutiert.
                            -->
                            <excludedMethods>
                                <param>renderScaledArgb</param>
                            </excludedMethods>
                            <!--
                              IT-Tests (Testcontainers+Docker) werden aus PIT ausgeschlossen.
                              PIT erkennt *IT-Klassen als normale Test-Klassen und versucht
                              sie ohne Docker auszuführen — das schlägt fehl ("did not pass
                              without mutation"). Fachliche Coverage für Persistence-Layer
                              über *Test-Unit-Tests und Surefire-Ergebnisse sichern.
                            -->
                            <excludedTestClasses>
                                <param>*IT</param>
                            </excludedTestClasses>
                            <!--
                              PIT forkt eigene Minion-JVMs; ohne allowAttachSelf kann
                              ByteBuddy den Agent nicht dynamisch laden und der Minion
                              crasht mit UNKNOWN_ERROR.
                            -->
                            <jvmArgs>
                                <value>-Djdk.attach.allowAttachSelf=true</value>
                            </jvmArgs>
                            <!--
                              #207: 100 % Mutation Score + Test Strength erreicht (alle
                              Survivor per Test gekillt oder aequivalente Mutanten per
                              Refactor eliminiert). Schwellen sind hart — jeder neue
                              Survivor bricht den Build.
                            -->
                            <mutationThreshold>100</mutationThreshold>
                            <testStrengthThreshold>100</testStrengthThreshold>
                            <timestampedReports>false</timestampedReports>
                            <!-- XML zusätzlich zum HTML-Report, um Survivor maschinell zu parsen (#203). -->
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                        </configuration>
                        <executions>
                            <execution>
                                <id>pit-mutation-coverage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
