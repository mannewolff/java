<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs-Excludes für die Toolbox.

  Pro Eintrag steht ein Kurzkommentar, warum ein Finding hier nicht als Bug zählt.
  Neue Excludes brauchen eine Begründung — niemals pauschal abklemmen.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

  <!--
    Records mit Listen oder Byte-Arrays sind unsere intended API. Defensive Copies
    machen wir bewusst in Konstruktor und Accessor (siehe UploadedImage,
    ToolImageResult, PaletteResult). Für die übrigen Records sind die Referenzen
    Teil des Werts — wir wollen keine zusätzliche Kopier-Schicht.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    <Or>
      <Class name="~.*Response"/>
      <Class name="~.*Result"/>
      <Class name="~.*Request"/>
      <Class name="~.*UseCase"/>
      <Class name="~.*UseCase\$.*"/>
      <Class name="~.*Adapter"/>
      <Class name="~.*Service"/>
      <Class name="~.*Controller"/>
    </Or>
  </Match>

  <!--
    NamedByteArrayResource ist eine private Helper-Klasse, die nur als file-Part-Resource
    für RestClient dient. equals() wird nie aufgerufen.
  -->
  <Match>
    <Class name="org.mwolff.api.tools.infrastructure.python.PythonToolsMultipart$NamedByteArrayResource"/>
    <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
  </Match>
</FindBugsFilter>
