docker-compose.override.yml
docker-compose.override.yaml

# Frontend build artifacts
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Python-tools build artifacts
python-tools/.venv/
python-tools/__pycache__/
python-tools/.pytest_cache/
python-tools/.coverage
python-tools/htmlcov/

# Claude Code workspace state (worktrees, session memory)
.claude/

# Generated PDF exports of docs
docs/*.pdf

# Local Whitepaper backups (older versions)
docs/Konzeptpapier_*
