DB_NAME=api
DB_USER=api
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Keycloak (Identity Provider, siehe infra/keycloak/README.md)
# KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD gelten NUR beim ersten Start des Containers
# als Bootstrap-Credentials. Anschliessend ueber das Keycloak-Admin-UI rotieren.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Passwort fuer den dedizierten Keycloak-DB-User (Schema 'keycloak' in der gemeinsamen MariaDB).
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db
