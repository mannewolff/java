{
  "realm": "toolbox",
  "enabled": true,
  "displayName": "Mannes Toolbox",
  "loginTheme": "toolbox",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 2592000,
  "passwordPolicy": "length(12) and specialChars(1) and notUsername",
  "defaultRole": {
    "name": "PENDING",
    "description": "Self-registered users land here until an admin promotes them to USER (admin-approval substitute).",
    "composite": false,
    "clientRole": false
  },
  "requiredCredentials": ["password"],
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyInitialCounter": 0,
  "otpPolicyLookAheadWindow": 1,
  "otpSupportedApplications": ["totpAppGoogleName", "totpAppFreeOTPName"],
  "roles": {
    "realm": [
      {
        "name": "PENDING",
        "description": "Default-Rolle fuer self-registered User. Admin schaltet sie spaeter zu USER frei.",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "USER",
        "description": "Standard-Anwender mit Zugriff auf Tools und Dashboards.",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "ADMIN",
        "description": "Administrator mit voller Verwaltung.",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "toolbox-web",
      "name": "Toolbox Web (SPA)",
      "description": "React-Frontend, Authorization Code Flow + PKCE.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://toolbox.mwolff.org/*"
      ],
      "webOrigins": [
        "https://toolbox.mwolff.org"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://toolbox.mwolff.org/*"
      },
      "optionalClientScopes": ["offline_access"],
      "protocolMappers": [
        {
          "name": "toolbox-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "toolbox-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "toolbox-api",
      "name": "Toolbox API (Spring Resource Server)",
      "description": "Bearer-only Resource Server. Akzeptiert JWTs, die fuer toolbox-api ausgestellt sind.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "toolbox-ios",
      "name": "Toolbox iOS (Native App)",
      "description": "Native SwiftUI-App, Authorization Code Flow + PKCE via ASWebAuthenticationSession.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "org.mwolff.toolboxkanban://callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "org.mwolff.toolboxkanban://callback"
      },
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "toolbox-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "toolbox-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
