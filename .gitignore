hs_err_pid*
replay_pid*

# Maven
target/

# IDE
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# OS
.DS_Store

# Environment
.env
.env.local

# Server-spezifische Compose-Overrides (siehe docker-compose.prod.yml.example).
